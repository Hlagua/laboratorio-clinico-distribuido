# Copiar como .env en la VM (NUNCA subir el .env real al repositorio).

# Azure SQL con el usuario app_sync (ver database/azure-sql/06_seguridad.sql)
AZURE_SQL_CONN=Driver={ODBC Driver 18 for SQL Server};Server=tcp:<servidor>.database.windows.net,1433;Database=<base>;Uid=app_sync;Pwd=<contraseña>;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=5;

# Supabase con el rol lab_sync (Session pooler, IPv4)
SUPABASE_DSN=postgresql://lab_sync.<project-ref>:<contraseña>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# MongoDB Atlas
MONGO_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=laboratorio

SYNC_INTERVALO=5
SYNC_BACKOFF_MAX=60
SYNC_MINUTOS_EXPIRAR_CITAS=30
SYNC_INSTANCIA=sync-vm1
