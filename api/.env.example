# Copiar como .env en cada VM (NUNCA subirlo al repositorio).
# INSTANCIA la define docker-compose para cada contenedor (api1..api4).

# Azure SQL con el usuario app_api (database/azure-sql/06_seguridad.sql)
AZURE_SQL_CONN=Driver={ODBC Driver 18 for SQL Server};Server=tcp:<servidor>.database.windows.net,1433;Database=<base>;Uid=app_api;Pwd=<contraseña>;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=3;
# Supabase con el rol de SOLO LECTURA lab_lectura (Session pooler, IPv4)
SUPABASE_DSN=postgresql://lab_lectura.<project-ref>:<contraseña>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

CB_TIMEOUT_CONEXION=3
CB_TIMEOUT_CONSULTA=10
CB_SEGUNDOS_ABIERTO=15

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"  (igual en las 4 APIs)
JWT_SECRETO=
JWT_HORAS=8
SOAP_API_KEY=
CORS_ORIGENES=

# Stripe en modo prueba (Dashboard > Developers > API keys / Webhooks)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
URL_PORTAL=https://<subdominio>.duckdns.org

# Mailjet
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAIL_REMITENTE=
MAIL_REMITENTE_NOMBRE=Laboratorio Clinico
NOTIFICADOR_INTERVALO=10

# Solo para la prueba comparativa de concurrencia (Fase VI); dejar en false al terminar.
PERMITIR_PRUEBA_CONCURRENCIA=false

# Guías clínicas de la base de conocimientos (MongoDB Atlas)
MONGO_URI=
MONGO_DB=laboratorio
